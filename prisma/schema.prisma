generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now())
  environments Environment[]
}

model Environment {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String
  projectId Int
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id])
  versions  Version[]

  @@unique([projectId, slug])
}

model Version {
  id            Int         @id @default(autoincrement())
  name          String
  environmentId Int
  s3Path        String
  isActive      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id])
  viewerAccess ViewerBuildAccess[]
  @@unique([environmentId, name])
}

model User {
  id                 Int                 @id @default(autoincrement())
  name            String?
  email              String              @unique
  passwordHash       String?
  role               Role                @default(VIEWER)
  isEmailVerified    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  verificationTokens VerificationToken[]
  viewerBuildAccess ViewerBuildAccess[]
  otpCode          String?
  otpExpiresAt     DateTime?
  otpAttempts      Int      @default(0)
  otpLockedUntil   DateTime?
  otpResendAfter   DateTime?
  refreshTokens RefreshToken[]
invitesCreated  UserInvite[] 
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AllowedEmailDomain {
  id        Int      @id @default(autoincrement())
  domain    String   @unique
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  DEV
  VIEWER
  QA
}

model ViewerBuildAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  versionId Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  version   Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([userId, versionId])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserInvite {
  id          Int      @id @default(autoincrement())
  email       String
  name        String?
  domain      String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById Int
role        Role         @default(VIEWER)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([email])
  @@index([status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}